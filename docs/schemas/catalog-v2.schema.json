{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferreiratechlab.github.io/KMP-catalog/schemas/catalog-v2.schema.json",
  "title": "KMP Catalog Snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "generatedAt", "items"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sequence": {"type": "integer", "minimum": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*[:\\\\])[ -~]+$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "sizeBytes", "license",
                   "infoHash", "magnet", "packageFile", "install"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "infoHash": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "magnet": {"type": "string", "pattern": "^magnet:\\?"},
        "torrent": {"type": "string", "contentEncoding": "base64"},
        "packageFile": {"type": "string", "pattern": "^[^/\\\\:]+\\.[zZ][iI][pP]$"},
        "packageSha256": {"$ref": "#/$defs/sha256"},
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["portId", "paths"],
          "properties": {
            "portId": {"$ref": "#/$defs/safeId"},
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true,
                      "items": {"$ref": "#/$defs/safePath"}}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"minimum": 3}}},
      "then": {"properties": {"items": {"items": {"required": ["packageSha256"]}}}}
    }
  ]
}
